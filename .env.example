# ===== Bắt buộc (server sẽ từ chối khởi động nếu thiếu) =====
# Agora Console > Project Management > App ID
AGORA_APP_ID=
# Agora Console > Project Management > Primary Certificate (TUYỆT ĐỐI không đưa ra frontend)
AGORA_APP_CERT=
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Mật khẩu giáo viên dùng để đăng nhập trang chủ
TEACHER_PASSWORD=

# ===== Tuỳ chọn =====
# URL HTTPS công khai của ứng dụng (Cloudflare Tunnel / domain đã bật proxy)
PUBLIC_URL=https://hoc.example.com
SERVER_PORT=3000
# Phòng tự hết hạn sau bao nhiêu giờ
ROOM_TTL_HOURS=12
# Số giờ hiệu lực của JWT phiên đăng nhập (mặc định = ROOM_TTL_HOURS)
SESSION_TTL_HOURS=12
# Thời gian giữ phòng chờ giáo viên quay lại khi cô rớt mạng (phút)
TEACHER_GRACE_MINUTES=10
# Số học viên tối đa mỗi phòng (thiết kế mở rộng tới 4)
MAX_STUDENTS_PER_ROOM=4
# Thời hạn token Agora (giây) - mặc định 2 giờ
AGORA_TOKEN_TTL_SECONDS=7200
# Đặt true để BỎ QUA video (chỉ thử giao diện/bảng vẽ khi chưa có App ID thật). Mặc định: false
AGORA_DISABLED=false
# Đặt false để tắt Content-Security-Policy khi cần gỡ lỗi SDK Agora
CSP_ENABLED=true
# Thêm origin được phép (phân cách bằng dấu phẩy), ví dụ khi tách frontend/backend
EXTRA_ALLOWED_ORIGINS=
# Thư mục lưu db.json và ảnh slide (mặc định: ./data và ./uploads)
DATA_DIR=
UPLOADS_DIR=
# production | development
NODE_ENV=production
